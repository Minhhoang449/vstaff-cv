# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.codebase-memory/
.codebase-memory.json
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Firebase service account (never commit)
*firebase-adminsdk*.json
**/serviceAccount*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# embedded local Postgres (PGlite)
/.data/

# uploaded CV avatars (generated at runtime)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# raw admin datasets (regenerate via scripts/generate-vietnam-wards.mjs)
/scripts/all-ward.json
/scripts/all-province.json
/scripts/sapnhap2025-vn.json
/scripts/provinces.generated.json
